[node name="奥州市" type="Marker2D" parent="Positions"]
position = Vector2(-311, 176)

[node name="description" type="Label" parent="Positions/奥州市"]
visible = false
offset_right = 40.0
offset_bottom = 23.0
text = "奥州市：
2006年に水沢市・江刺市、胆沢郡前沢町・胆沢町・衣川村が新設合併して誕生した。
旧前沢町は前沢牛が有名。"

[node name="picture" type="Sprite2D" parent="Positions/奥州市"]
visible = false

[node name="金ケ崎町" type="Marker2D" parent="Positions"]
position = Vector2(-314, 140)

[node name="description" type="Label" parent="Positions/金ケ崎町"]
visible = false
offset_right = 40.0
offset_bottom = 23.0
text = "金ケ崎町：
小さい面積でありながら工業生産が盛ん。
県内の小学校には金ケ崎町のトヨタの工場見学するところが多い。"

[node name="picture" type="Sprite2D" parent="Positions/金ケ崎町"]
visible = false

[node name="北上市" type="Marker2D" parent="Positions"]
position = Vector2(-314, 117)

[node name="description" type="Label" parent="Positions/北上市"]
visible = false
offset_right = 40.0
offset_bottom = 23.0
text = "北上市：
奥羽山脈の山が低い関係上，雪が多く積もる。"

[node name="picture" type="Sprite2D" parent="Positions/北上市"]
visible = false

[node name="花巻市" type="Marker2D" parent="Positions"]
